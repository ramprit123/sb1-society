      "output": "single",
      "favicon": "./assets/images/ios-light.png"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c1c44615-8e44-433b-b658-3193e542314e"
      }
    }
  }
}
